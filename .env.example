# Copy to .env.local for `next dev`, and to .dev.vars for `npm run preview` (wrangler).

# Supabase project (Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Public URL of this app (used in emails and tracking links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile. These are Cloudflare's always-pass test keys; replace in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Random 32+ character string. Salts the IP/device hashes used for rate limiting.
HASH_SALT=change-me-to-a-long-random-string

# Resend (https://resend.com). Leave empty in development to log emails to the console instead.
RESEND_API_KEY=
EMAIL_FROM=BetterCabanatuan Sumbong <sumbong@bettercabanatuan.org>
